import pandas as pd
from sklearn.ensemble import RandomForestClassifier

# Load the main dataset tab into a DataFrame
data = pd.read_excel('iris_dataset.xlsx', sheet_name='Iris Dataset')



# Display the first few rows to verify the headings
print(data.head())

X = data.iloc[:, :-1]  # All columns except the last as features
Y = data.iloc[:, -1]   # Last column as label
data
# print(df.info())
# y = df['SPECIES']


model = RandomForestClassifier()


model.fit(X,Y)


X.values


predictions = model.predict([[5.1,3.5,1.4,0.2]])


predictions


df1 = pd.read_excel("iris_test_aligned.xlsx")
df1


testing = df1.iloc[: ,:-1]


testing


predictions = model.predict(testing)


predictions



