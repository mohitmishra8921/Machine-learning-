import pandas as pd
from sklearn.ensemble import RandomForestClassifier

# Load the main dataset tab into a DataFrame
df = pd.read_excel('iris_dataset.xlsx', sheet_name='Iris Dataset')

# Convert all column headings to uppercase (capital letters)
df.columns = df.columns.str.upper()

# (Optional) If you prefer Title Case (e.g., 'Sepal_Length'), use this instead:
# df.columns = df.columns.str.title()

# Display the first few rows to verify the headings
print(df.head())

# Features (X) and Target (y) split for model training 
# (Make sure to match the new uppercase column names here)
X = df[['SEPAL_LENGTH', 'SEPAL_WIDTH', 'PETAL_LENGTH', 'PETAL_WIDTH']]
Y = df['SPECIES']
df
# print(df.info())
# y = df['SPECIES']


model = RandomForestClassifier()


model.fit(X,Y)


X.values


predictions = model.predict([[5.1,3.5,1.4,0.2]])


predictions


